# Map provider: "google" (default, needs API key) or "maplibre" (keyless, free OpenFreeMap tiles).
# Copy this file to .env.local and fill in your key. .env.local is gitignored.
VITE_MAP_PROVIDER=google

# Google Maps JavaScript API key (https://console.cloud.google.com/google/maps-apis)
VITE_GOOGLE_MAPS_API_KEY=

# Billable map loads per month before Google Maps pauses *in one browser* (counted in
# localStorage). This is a courtesy limit, not billing protection: every visitor gets their
# own count. To cap real spend, set a daily quota on the Maps JavaScript API and restrict the
# key to your site's domain in Google Cloud Console.
# VITE_GOOGLE_LOAD_LIMIT=2000